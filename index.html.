
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My AI Project</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 20px;
      background: #101827;
      color: white;
      font-family: Arial, sans-serif;
    }
    main {
      width: 100%;
      max-width: 500px;
      padding: 35px 24px;
      border-radius: 18px;
      text-align: center;
      background: #1e293b;
      border: 1px solid #38bdf8;
    }
    h1 { color: #38bdf8; }
    input, button {
      padding: 12px;
      margin: 8px 0;
      border-radius: 8px;
      font-size: 16px;
    }
    input { width: 100%; border: 1px solid #94a3b8; }
    button {
      border: 0;
      background: #38bdf8;
      color: #082f49;
      cursor: pointer;
      font-weight: bold;
    }
    #result { margin-top: 18px; overflow-wrap: anywhere; }
  </style>
</head>
<body>
  <main>
    <h1>My AI Project</h1>
    <p>Welcome to my cloud-based AI model demonstration.</p>
    <p>Enter text below to test the demo.</p>
    <input id="userInput" placeholder="Enter your text">
    <br>
    <button onclick="runDemo()">Run Demo</button>
    <p id="result">Your result will appear here.</p>
  </main>

  <script>
    function runDemo() {
      const input = document.getElementById("userInput").value.trim();
      const result = document.getElementById("result");

      if (!input) {
        result.textContent = "Please enter some text.";
        return;
      }

      result.textContent =
        "Demo result: Your text contains " + input.length + " characters.";
    }
  </script>
</body>
</html>
