
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My AI Website</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #101827, #164e63);
      color: white;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
    }
    .card {
      background: rgba(255,255,255,0.1);
      padding: 35px 25px;
      border-radius: 18px;
      width: 85%;
      max-width: 480px;
      box-sizing: border-box;
    }
    h1 { color: #67e8f9; }
    input, button {
      padding: 12px;
      margin: 7px 0;
      border: none;
      border-radius: 8px;
      font-size: 16px;
    }
    input { width: 90%; }
    button {
      background: #06b6d4;
      color: #071827;
      cursor: pointer;
      font-weight: bold;
    }
    #result { margin-top: 18px; line-height: 1.6; }
  </style>
</head>
<body>
  <main class="card">
    <h1>My AI Website</h1>
    <p>Welcome to my cloud-based AI model project.</p>
    <p>Enter a message to test the demo.</p>
    <input id="message" type="text" placeholder="Type something...">
    <br>
    <button onclick="predict()">Run Demo</button>
    <div id="result"></div>
  </main>

  <script>
    function predict() {
      const message = document.getElementById("message").value.trim();
      const result = document.getElementById("result");

      if (!message) {
        result.textContent = "Please enter a message first.";
        return;
      }

      result.textContent =
        "Demo prediction: Your input contains " +
        message.length + " characters.";
    }
  </script>
</body>
</html>
